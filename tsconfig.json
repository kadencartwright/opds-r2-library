{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "alchemy.run.ts",
    "vite.config.ts",
    "scripts"
  ]
}
